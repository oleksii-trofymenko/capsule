# Capsule environment variables. Dummy values only: copy to .env and change them locally.
# Never commit .env. Read by apps/api/core/config.py (one settings object).

# Postgres 16 + pgvector (ADR-007). postgresql:// is normalised to the psycopg 3 driver.
DATABASE_URL=postgresql://capsule:change-me@localhost:5432/capsule
# Redis (ADR-006). Use rediss:// for TLS.
REDIS_URL=redis://localhost:6379/0
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Seconds each /v1/ready check may take (0 < value <= 10).
READY_CHECK_TIMEOUT_S=1.0
