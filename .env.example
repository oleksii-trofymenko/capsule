# Capsule environment variables. Dummy values only. Never commit .env.
# `make up` copies this file to .env on first run and replaces every `change-me` value with a
# random secret. Compose reads .env (infra/compose/compose.base.yml); the API reads the
# variables it is given (apps/api/core/config.py, one settings object).

# --- Compose stack: credentials (make up generates them) ---
# Postgres 16 + pgvector (ADR-007).
POSTGRES_USER=capsule
POSTGRES_PASSWORD=change-me
POSTGRES_DB=capsule
# Redis (ADR-006). Required by the server and part of REDIS_URL.
REDIS_PASSWORD=change-me
# SeaweedFS S3 identity (ADR-008). No S3 request is accepted without it.
SEAWEEDFS_S3_ACCESS_KEY=change-me
SEAWEEDFS_S3_SECRET_KEY=change-me
# SeaweedFS JWT keys (security.toml). The filer key protects the S3 IAM gRPC port (18333).
SEAWEEDFS_JWT_SIGNING_KEY=change-me
SEAWEEDFS_JWT_FILER_SIGNING_KEY=change-me

# --- Compose stack: settings ---
# Host port of the API, published on 127.0.0.1 only.
API_HOST_PORT=8000
# Redis memory cap; only keys with a TTL are evicted (volatile-lru, ADR-006).
REDIS_MAXMEMORY=512mb

# --- API settings ---
# Compose builds DATABASE_URL and REDIS_URL from the values above and the service names. Set them
# yourself only to run the API outside Compose, e.g.:
# DATABASE_URL=postgresql://capsule:change-me@localhost:5432/capsule   (postgresql:// is normalised to psycopg 3)
# REDIS_URL=redis://:change-me@localhost:6379/0                        (rediss:// for TLS)
# DEBUG, INFO, WARNING or ERROR.
LOG_LEVEL=INFO
# Seconds each /v1/ready probe may take in total (0 < value <= 10).
READY_PROBE_TIMEOUT_S=1.0
# Client timeouts for normal traffic: Postgres connect (whole seconds, 1-60), Redis socket (0-60).
# Intentionally longer than the probe timeout: the probe budget alone governs /v1/ready.
DATABASE_CONNECT_TIMEOUT_S=5
REDIS_SOCKET_TIMEOUT_S=5.0
