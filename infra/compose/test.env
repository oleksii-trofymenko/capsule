# Test-only values for the throwaway `capsule-test` stack (make test). Not secrets: these
# containers live for one test run, bind to 127.0.0.1 only and hold no real data.
POSTGRES_USER=capsule
POSTGRES_PASSWORD=capsule
POSTGRES_DB=capsule_test
REDIS_PASSWORD=capsule
SEAWEEDFS_S3_ACCESS_KEY=capsule-test
SEAWEEDFS_S3_SECRET_KEY=capsule-test-only
SEAWEEDFS_JWT_SIGNING_KEY=capsule-test-only
SEAWEEDFS_JWT_FILER_SIGNING_KEY=capsule-test-only
