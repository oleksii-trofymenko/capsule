{
  "$description": "Capsule design tokens, single source for the mobile app (card E0-09). Format: W3C Design Tokens (DTCG) draft as read by Style Dictionary v4: colours are hex strings (#RRGGBB or #RRGGBBAA), dimensions are {value, unit} where 'px' means iOS pt / Android dp, durations are {value, unit:'ms'}. Aliases are '{path.to.token}' from the file root. Layers: 'primitive' = raw palette, never used by components directly; 'base' = theme-independent scales (font, text styles, space, radius, size, motion); 'semantic.light' and 'semantic.dark' have identical keys and alias primitives. Import shape: theme[scheme].group.token, e.g. semantic.light.text.primary -> theme.light.text.primary; base.space.4 -> base.space[4]. Contrast for every pair: docs/design/components.md -> Contrast. Font: Plus Jakarta Sans must be bundled in the app (OFL files, E1 mobile card); no system-font fallback except while fonts load (keep the splash screen until then).",

  "primitive": {
    "color": {
      "$type": "color",
      "white": { "$value": "#FFFFFF" },
      "black": { "$value": "#000000" },
      "ink": {
        "900": { "$value": "#1E1A24", "$description": "Primary text, light theme" },
        "700": { "$value": "#4F4855", "$description": "Secondary text, light theme" },
        "600": { "$value": "#675F6C", "$description": "Muted text and placeholders, light theme (replaces canvas #8A8290 for placeholders)" },
        "400": { "$value": "#8A8290", "$description": "Control borders and switch off-track only (3:1 non-text). Never text." }
      },
      "rust": {
        "300": { "$value": "#F2A08A", "$description": "Accent text and icons, dark theme" },
        "500": { "$value": "#BF4A33", "$description": "Brand gradient start; icons and large text only" },
        "700": { "$value": "#A13F2B", "$description": "Accent text at any size, light theme (owner decision; replaces canvas #9C3F43 and #8A3A2A)" }
      },
      "plum": {
        "300": { "$value": "#D4A8F0", "$description": "Link, success and focus, dark theme" },
        "400": { "$value": "#A86BCF", "$description": "Switch on-track and budget fill end, dark theme" },
        "500": { "$value": "#7A3E9D", "$description": "Brand gradient end; icons, focus ring, switch on-track (light)" },
        "600": { "$value": "#6B3A8A", "$description": "Link, status and success text, light theme" },
        "700": { "$value": "#5E2E7A", "$description": "Link pressed, light theme" }
      },
      "berry": {
        "500": { "$value": "#9C4468", "$description": "Brand gradient midpoint (typing dot)" }
      },
      "coral": {
        "400": { "$value": "#D9684F", "$description": "Budget fill start, dark theme" }
      },
      "cream": {
        "50": { "$value": "#FFF5EE", "$description": "Background gradient top" }
      },
      "blush": {
        "50": { "$value": "#FBF2EE", "$description": "Sunken surface (budget box, photo item rows, tips)" },
        "100": { "$value": "#FBEAE3", "$description": "Background gradient middle" },
        "150": { "$value": "#FBE7DF", "$description": "Warning / error tint (icon tiles, banners)" },
        "200": { "$value": "#F6E6DF", "$description": "Placeholder and skeleton gradient start" },
        "300": { "$value": "#EFDFD9", "$description": "Budget bar track" }
      },
      "lilac": {
        "50": { "$value": "#F5E7F0", "$description": "Tag surface, pressed surface, success tint" },
        "100": { "$value": "#F4E4EF", "$description": "Background gradient bottom" },
        "200": { "$value": "#EEDFEC", "$description": "Placeholder and skeleton gradient end" },
        "300": { "$value": "#EADCEB", "$description": "Pending bubble, disabled surface, progress track" }
      },
      "night": {
        "950": { "$value": "#14101A", "$description": "Budget track, dark" },
        "900": { "$value": "#18131C", "$description": "Background gradient bottom, dark" },
        "850": { "$value": "#1A1419", "$description": "Background gradient middle, dark" },
        "800": { "$value": "#1C1517", "$description": "Background gradient top, dark" },
        "700": { "$value": "#1F1824", "$description": "Header surface, dark" },
        "600": { "$value": "#231C28", "$description": "Sunken surface, dark" },
        "500": { "$value": "#2A2230", "$description": "Card, bubble and sheet surface, dark" },
        "400": { "$value": "#2E2733", "$description": "Disabled surface, dark" },
        "300": { "$value": "#3A2E44", "$description": "Tag, pending bubble, pressed surface, progress track, dark" }
      },
      "ember": {
        "900": { "$value": "#3D2420", "$description": "Warning / error tint, dark" }
      },
      "mist": {
        "50": { "$value": "#F7F1F5", "$description": "Primary text, dark" },
        "200": { "$value": "#D6CCD6", "$description": "Secondary text, dark" },
        "400": { "$value": "#B3A8B5", "$description": "Muted text and placeholders, dark" }
      },
      "alpha": {
        "white60": { "$value": "#FFFFFF99" },
        "white78": { "$value": "#FFFFFFC7" },
        "white10": { "$value": "#FFFFFF1A" },
        "ink05": { "$value": "#1E1A240D" },
        "ink06": { "$value": "#1E1A240F" },
        "ink10": { "$value": "#1E1A241A" },
        "ink12": { "$value": "#1E1A241F" },
        "ink40": { "$value": "#1E1A2466" },
        "plum06": { "$value": "#7A3E9D0F" },
        "plum08": { "$value": "#7A3E9D14" },
        "plum10": { "$value": "#7A3E9D1A" },
        "plum16": { "$value": "#7A3E9D29" },
        "plum30": { "$value": "#7A3E9D4D" },
        "night700at85": { "$value": "#1F1824D9" },
        "black24": { "$value": "#0000003D" },
        "black40": { "$value": "#00000066" },
        "black60": { "$value": "#00000099" }
      }
    }
  },

  "base": {
    "font": {
      "family": {
        "brand": { "$type": "fontFamily", "$value": "Plus Jakarta Sans", "$description": "Used for all text. Bundle weights 400, 500, 600, 700, 800 (OFL). On Android each weight is registered as its own family name; map fontWeight -> file in E1." }
      },
      "weight": {
        "$type": "fontWeight",
        "regular": { "$value": 400 },
        "medium": { "$value": 500 },
        "semibold": { "$value": 600 },
        "bold": { "$value": 700 },
        "extrabold": { "$value": 800 }
      },
      "scale": {
        "max": { "$type": "number", "$value": 2, "$description": "maxFontSizeMultiplier for every text style (Dynamic Type / font scale up to 200 %). Font scaling is never disabled." }
      }
    },

    "textStyle": {
      "$description": "Leaf tokens map one-to-one to React Native text style keys. Line heights are absolute; at font scale s use lineHeight * s (keep the ratio). Minimum size 12.",
      "display": {
        "$description": "Guide title (H1)",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 34, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.extrabold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": -0.6, "unit": "px" } }
      },
      "title": {
        "$description": "Screen and sheet titles, onboarding titles, guide title in chat",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 28, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.extrabold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": -0.4, "unit": "px" } }
      },
      "heading": {
        "$description": "Section titles (H2): The key pieces, Why this works",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 19, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.extrabold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": -0.3, "unit": "px" } }
      },
      "headerTitle": {
        "$description": "Navigation header title: Capsule, Your guide",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 17, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.extrabold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": -0.3, "unit": "px" } }
      },
      "subtitle": {
        "$description": "Item names (H3), budget amount, guide card title, banner lead. Prices use tabular figures.",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 22, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.bold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": -0.2, "unit": "px" } }
      },
      "body": {
        "$description": "Capsule messages, paragraphs, banner body",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.regular}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "bodyMedium": {
        "$description": "User messages on the brand gradient, text field input",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 24, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.medium}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "bodySmall": {
        "$description": "Item reasons, helper text, row descriptions, why-this-works bullets",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.regular}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "label": {
        "$description": "Button labels",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 15, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.bold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "labelSmall": {
        "$description": "Chips, link buttons (View at shop), list row labels",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 14, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 20, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.semibold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "caption": {
        "$description": "Section subtitles, transcript, sizes privacy note, header subtitle",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 13, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 18, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.medium}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "micro": {
        "$description": "Status lines (Sent, queued), tags and badges, date chip, budget status. Smallest size in the app.",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.bold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0, "unit": "px" } }
      },
      "eyebrow": {
        "$description": "Occasion eyebrow, SAVED ON THIS PHONE. Upper case is applied by style, the copy deck stays in sentence case so screen readers do not spell it out.",
        "fontFamily": { "$type": "fontFamily", "$value": "{base.font.family.brand}" },
        "fontSize": { "$type": "dimension", "$value": { "value": 12, "unit": "px" } },
        "lineHeight": { "$type": "dimension", "$value": { "value": 16, "unit": "px" } },
        "fontWeight": { "$type": "fontWeight", "$value": "{base.font.weight.extrabold}" },
        "letterSpacing": { "$type": "dimension", "$value": { "value": 0.9, "unit": "px" } },
        "$extensions": { "app.capsule": { "textTransform": "uppercase" } }
      }
    },

    "space": {
      "$type": "dimension",
      "$description": "4-pt scale. 'half' is only for stacked text pairs (title + subtitle).",
      "0": { "$value": { "value": 0, "unit": "px" } },
      "half": { "$value": { "value": 2, "unit": "px" } },
      "1": { "$value": { "value": 4, "unit": "px" } },
      "2": { "$value": { "value": 8, "unit": "px" } },
      "3": { "$value": { "value": 12, "unit": "px" } },
      "4": { "$value": { "value": 16, "unit": "px" } },
      "5": { "$value": { "value": 20, "unit": "px" } },
      "6": { "$value": { "value": 24, "unit": "px" } },
      "8": { "$value": { "value": 32, "unit": "px" } },
      "10": { "$value": { "value": 40, "unit": "px" } },
      "12": { "$value": { "value": 48, "unit": "px" } },
      "16": { "$value": { "value": 64, "unit": "px" } }
    },

    "radius": {
      "$type": "dimension",
      "xs": { "$value": { "value": 6, "unit": "px" }, "$description": "Bubble corner on the tail side" },
      "sm": { "$value": { "value": 10, "unit": "px" }, "$description": "Tags, badges, date chip" },
      "md": { "$value": { "value": 14, "unit": "px" }, "$description": "Link buttons, icon tiles, item images, list rows inside cards" },
      "lg": { "$value": { "value": 18, "unit": "px" }, "$description": "Inset boxes (budget box), text fields" },
      "xl": { "$value": { "value": 22, "unit": "px" }, "$description": "Cards, bubbles, banners, sheets (top corners)" },
      "pill": { "$value": { "value": 999, "unit": "px" }, "$description": "Buttons, chips, composer, segmented control" }
    },

    "size": {
      "$type": "dimension",
      "touchTarget": { "$value": { "value": 48, "unit": "px" }, "$description": "Minimum hit area on both platforms (meets 44 pt iOS and 48 dp Android). Smaller visuals extend with hitSlop." },
      "buttonHeight": { "$value": { "value": 48, "unit": "px" }, "$description": "Minimum; grows with text" },
      "chipHeight": { "$value": { "value": 44, "unit": "px" }, "$description": "Minimum visual height; hit area 48 via hitSlop; grows with text" },
      "linkButtonHeight": { "$value": { "value": 44, "unit": "px" } },
      "iconButton": { "$value": { "value": 48, "unit": "px" } },
      "sendButton": { "$value": { "value": 44, "unit": "px" }, "$description": "Visual; hit area 48" },
      "composerMinHeight": { "$value": { "value": 56, "unit": "px" } },
      "icon": { "$value": { "value": 24, "unit": "px" } },
      "iconSmall": { "$value": { "value": 16, "unit": "px" } },
      "iconTile": { "$value": { "value": 36, "unit": "px" } },
      "avatar": { "$value": { "value": 36, "unit": "px" } },
      "stepBadge": { "$value": { "value": 28, "unit": "px" }, "$description": "Numbered section badge" },
      "itemImageWidth": { "$value": { "value": 72, "unit": "px" } },
      "itemImageHeight": { "$value": { "value": 84, "unit": "px" } },
      "itemImageCompact": { "$value": { "value": 56, "unit": "px" }, "$description": "Square, at font scale >= 1.5" },
      "budgetBarHeight": { "$value": { "value": 10, "unit": "px" } },
      "tailWidth": { "$value": { "value": 14, "unit": "px" } },
      "tailHeight": { "$value": { "value": 18, "unit": "px" } },
      "borderControl": { "$value": { "value": 1, "unit": "px" } },
      "focusRingWidth": { "$value": { "value": 2, "unit": "px" } },
      "focusRingOffset": { "$value": { "value": 2, "unit": "px" } },
      "screenGutter": { "$value": { "value": 16, "unit": "px" } },
      "bubbleMaxWidth": { "$type": "number", "$value": 0.82, "$description": "Fraction of the content width" }
    },

    "motion": {
      "duration": {
        "$type": "duration",
        "fast": { "$value": { "value": 150, "unit": "ms" }, "$description": "Press feedback, chip select" },
        "base": { "$value": { "value": 250, "unit": "ms" }, "$description": "Banners, bubbles entering, sheet content" },
        "slow": { "$value": { "value": 400, "unit": "ms" }, "$description": "Sheets, budget bar fill" },
        "typingLoop": { "$value": { "value": 1200, "unit": "ms" }, "$description": "Typing dots and spinner cycle" }
      },
      "easing": {
        "$type": "cubicBezier",
        "standard": { "$value": [0.2, 0, 0, 1] },
        "decelerate": { "$value": [0, 0, 0, 1] }
      },
      "$description": "Reduce Motion on: durations become 0, loops (typing dots, spinner, streaming caret) are static. Status is still announced."
    }
  },

  "semantic": {
    "light": {
      "bg": {
        "$type": "color",
        "top": { "$value": "{primitive.color.cream.50}" },
        "middle": { "$value": "{primitive.color.blush.100}" },
        "bottom": { "$value": "{primitive.color.lilac.100}" }
      },
      "gradient": {
        "$type": "gradient",
        "background": {
          "$value": [
            { "color": "{semantic.light.bg.top}", "position": 0 },
            { "color": "{semantic.light.bg.middle}", "position": 0.5 },
            { "color": "{semantic.light.bg.bottom}", "position": 1 }
          ],
          "$extensions": { "app.capsule": { "angleDeg": 180, "start": [0, 0], "end": [0, 1] } }
        },
        "brand": {
          "$description": "Primary buttons, user bubbles, selected chips, send button, avatar. Same in both themes.",
          "$value": [
            { "color": "{primitive.color.rust.500}", "position": 0 },
            { "color": "{primitive.color.plum.500}", "position": 1 }
          ],
          "$extensions": { "app.capsule": { "angleDeg": 135, "start": [0, 0], "end": [1, 1] } }
        },
        "budget": {
          "$value": [
            { "color": "{primitive.color.rust.500}", "position": 0 },
            { "color": "{primitive.color.plum.500}", "position": 1 }
          ],
          "$extensions": { "app.capsule": { "angleDeg": 90, "start": [0, 0.5], "end": [1, 0.5] } }
        },
        "placeholder": {
          "$description": "Missing product image, skeleton blocks",
          "$value": [
            { "color": "{primitive.color.blush.200}", "position": 0 },
            { "color": "{primitive.color.lilac.200}", "position": 1 }
          ],
          "$extensions": { "app.capsule": { "angleDeg": 160, "start": [0.33, 0], "end": [0.67, 1] } }
        }
      },
      "surface": {
        "$type": "color",
        "card": { "$value": "{primitive.color.white}", "$description": "Cards, Capsule bubble, chips, composer, sheets, banners" },
        "sunken": { "$value": "{primitive.color.blush.50}" },
        "tag": { "$value": "{primitive.color.lilac.50}" },
        "pending": { "$value": "{primitive.color.lilac.300}", "$description": "Queued user message" },
        "disabled": { "$value": "{primitive.color.lilac.300}" },
        "pressed": { "$value": "{primitive.color.lilac.50}", "$description": "Pressed state of white surfaces (chips, secondary buttons, rows)" },
        "pressedOnBrand": { "$value": "{primitive.color.alpha.ink12}", "$description": "Overlay on the brand gradient when pressed, both themes" },
        "header": { "$value": "{primitive.color.alpha.white78}", "$description": "Translucent; no blur needed" },
        "timestamp": { "$value": "{primitive.color.alpha.white60}" },
        "scrim": { "$value": "{primitive.color.alpha.ink40}", "$description": "Behind sheets and dialogs" }
      },
      "text": {
        "$type": "color",
        "primary": { "$value": "{primitive.color.ink.900}" },
        "secondary": { "$value": "{primitive.color.ink.700}" },
        "muted": { "$value": "{primitive.color.ink.600}" },
        "placeholder": { "$value": "{primitive.color.ink.600}" },
        "disabled": { "$value": "{primitive.color.ink.600}", "$description": "Used on surface.disabled; still passes 4.5:1" },
        "accent": { "$value": "{primitive.color.rust.700}", "$description": "Eyebrows, on-device badge, queued, over budget, unavailable" },
        "link": { "$value": "{primitive.color.plum.600}", "$description": "Link buttons, status subtitle, success text" },
        "linkPressed": { "$value": "{primitive.color.plum.700}" },
        "onBrand": { "$value": "{primitive.color.white}" }
      },
      "icon": {
        "$type": "color",
        "default": { "$value": "{primitive.color.ink.900}" },
        "muted": { "$value": "{primitive.color.ink.600}" },
        "accent": { "$value": "{primitive.color.rust.500}" },
        "brand": { "$value": "{primitive.color.plum.500}" },
        "onBrand": { "$value": "{primitive.color.white}" }
      },
      "border": {
        "$type": "color",
        "control": { "$value": "{primitive.color.ink.400}", "$description": "Unselected chips, secondary and link buttons, text fields, radio rows (>= 3:1)" },
        "subtle": { "$value": "{primitive.color.alpha.ink10}", "$description": "Decorative dividers only" }
      },
      "focus": {
        "$type": "color",
        "ring": { "$value": "{primitive.color.plum.500}" }
      },
      "status": {
        "$type": "color",
        "success": {
          "fg": { "$value": "{primitive.color.plum.600}", "$description": "Within budget, in the look, Saved. Always with a tick icon." },
          "bg": { "$value": "{primitive.color.lilac.50}" }
        },
        "warning": {
          "fg": { "$value": "{primitive.color.rust.700}", "$description": "Offline, queued, over budget, unavailable. Always with an icon and text." },
          "bg": { "$value": "{primitive.color.blush.150}" }
        },
        "error": {
          "fg": { "$value": "{primitive.color.rust.700}", "$description": "Same hue as warning on purpose: no red/green pair. Told apart by icon and copy." },
          "bg": { "$value": "{primitive.color.blush.150}" }
        },
        "info": {
          "fg": { "$value": "{primitive.color.plum.600}" },
          "bg": { "$value": "{primitive.color.lilac.50}" }
        }
      },
      "control": {
        "$type": "color",
        "switchOn": { "$value": "{primitive.color.plum.500}" },
        "switchOff": { "$value": "{primitive.color.ink.400}" },
        "thumb": { "$value": "{primitive.color.white}" },
